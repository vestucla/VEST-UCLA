rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/config/admins) &&
        request.auth.token.email in get(/databases/$(database)/documents/config/admins).data.emails;
    }

    function isOwner() {
      return isAuthenticated() && resource.data.email == request.auth.token.email;
    }


    function ownsMember(memberId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/members/$(memberId)) &&
        get(/databases/$(database)/documents/members/$(memberId)).data.email == request.auth.token.email;
    }

    function ownerCanUpdateMember() {
      return isOwner() &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status;
    }

    match /members/{memberId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || ownerCanUpdateMember();
      allow delete: if isAdmin();
    }

    match /memberContacts/{memberId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || ownsMember(memberId);
      allow delete: if isAdmin();
    }

    match /config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
